# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPEN_AI_API_KEY: Required for the OpenAI Chatbot backend.
# Add it to AI Studio Secrets named OPEN_AI_API_KEY (or OPENAI_API_KEY).
OPEN_AI_API_KEY="MY_OPENAI_API_KEY"
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# HEYGEN_API_KEY: Required for live video call feature. 
# 1. Get your API key from HeyGen Enterprise/Developer console. 
# 2. Add it to AI Studio Secrets named HEYGEN_API_KEY.
# 3. Whitelist your domain in HeyGen Space Settings -> Whitelisted Domains.
#    Current domains to whitelist:
#    - ais-dev-7qnz4sdbdp4qe5wrhiga5y-263030089229.us-east1.run.app
#    - ais-pre-7qnz4sdbdp4qe5wrhiga5y-263030089229.us-east1.run.app
#    - thetransformationroom.com
HEYGEN_API_KEY=
# HeyGen IDs (Optional: defaults to system choice if not set)
HEYGEN_AVATAR_ID=
VITE_HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
VITE_HEYGEN_VOICE_ID=
